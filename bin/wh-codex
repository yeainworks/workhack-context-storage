#!/bin/sh
# Запуск Codex с контекстом WorkHack из общей памяти.
#   wh-codex "задача на сегодня"
# Читает контекст (wh start), подставляет его в первый запрос Codex, а после выхода пишет в журнал,
# что сессия закончилась (если итог не записан, партнёр это увидит).
d=$(cd "$(dirname "$0")" && pwd)
ctx=$("$d/wh" start 2>&1)
prompt="Работай по правилам общей памяти WorkHack. Ниже контекст из бакета: прочитай его целиком. В конце работы выполни: wh done \"что сделано + ссылки на файлы\".

$ctx

ЗАДАЧА: $*"
codex "$prompt"
code=$?
"$d/wh" log session-end "Codex: сессия закончилась (код $code). Итог мог быть не записан." >/dev/null 2>&1
exit $code
